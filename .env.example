# Copy this file to .env and fill in the values. Never commit .env.

# Model served by the API: Hugging Face repository and a fixed revision
# (release tag such as v0.1.0, or a 40-character commit hash; "main" is refused).
MODEL_REPO_ID=AmandaGondra/ncm-classifier
MODEL_REVISION=v0.1.0

# Optional: only needed for a private repository. Publishing uses `hf auth login` instead.
HF_TOKEN=

# Where downloaded model files are cached (empty: Hugging Face default cache).
MODEL_CACHE_DIR=

# Comma-separated origins allowed to call the API from a browser (empty: none).
ALLOWED_ORIGINS=

# Limits of POST /v1/predictions.
MAX_TEXT_LENGTH=500
MAX_BATCH_SIZE=20
MAX_REQUEST_BODY_BYTES=65536

LOG_LEVEL=INFO
